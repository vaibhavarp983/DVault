# Full persisted demo: start FastAPI and point the shell at it.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WORKSPACE_REF=default
VITE_ENABLE_DEMO_CONTROLS=true

# External OCR goes through the DVault API to Google Cloud Vision.
# Set VITE_OCR_MODE=local for the browser-only Tesseract fallback.
VITE_OCR_MODE=external
VITE_OCR_PROVIDER_LABEL=Google Cloud Vision

# Offline UI mode: leave VITE_API_BASE_URL empty to use the local synthetic fixture.
# VITE_API_BASE_URL=
