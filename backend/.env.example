DATABASE_URL=sqlite:///./dvault.db
ENVIRONMENT=development
HMAC_SECRET=replace-with-a-local-development-secret-at-least-32-characters
SOURCE_STORE_DIR=./source_stores
ENABLE_FAILURE_INJECTION=true
ENABLE_DEMO_CONTROLS=true
DEMO_SHOW_SYNTHETIC_CONTACTS=true
AUDIT_SIGNING_KEY_PATH=./.keys/audit_signing_key.pem
AUDIT_KEY_ID=local-demo-v1
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
